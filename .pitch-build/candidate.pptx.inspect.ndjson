{"kind":"textbox","id":"sh/698jyl0n","slideIndex":0,"position":{"left":72,"top":452,"width":520,"height":70},"text":"Preparedness that stays close, even offline","geometry":"rect","lineWidth":0,"style":{"fontSize":23,"typeface":"Arial","color":"#E8CFC2","alignment":"left"}}
