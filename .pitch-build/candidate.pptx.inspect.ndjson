{"kind":"textbox","id":"sh/y1cfep0j","slideIndex":2,"position":{"left":68,"top":439,"width":590,"height":78},"text":"Emergency contacts are organized by location, with a manual fallback.","geometry":"rect","lineWidth":0,"style":{"fontSize":23,"typeface":"Arial","color":"#625954","alignment":"left"}}
{"kind":"textbox","id":"sh/98net4z6","slideIndex":2,"position":{"left":68,"top":592,"width":600,"height":42},"text":"Guide content and hotline numbers require authority review before release.","geometry":"rect","lineWidth":0,"style":{"fontSize":16,"typeface":"Arial","color":"#E8590C","alignment":"left"}}
